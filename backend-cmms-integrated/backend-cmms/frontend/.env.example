# API scheme/host/port the SPA talks to. The tenant subdomain (e.g.
# nusantara.localhost) is resolved at login time from the user's
# membership and combined with VITE_API_PORT automatically — you
# normally don't need to change anything here for local dev.
VITE_API_SCHEME=http
VITE_API_CENTRAL_HOST=localhost
VITE_API_PORT=8000
